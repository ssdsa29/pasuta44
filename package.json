{
  "name": "x-timeline-scraper",
  "version": "1.0.0",
  "description": "X(Twitter)のおすすめ欄・フォロー欄から、APIを使わずに投稿・画像・コメントを収集し、複数アカウントを管理・操作するデスクトップツール",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/index.js",
    "setup": "npm install && npx playwright install chromium",
    "test": "node test/resilience.test.mjs && node test/server.test.mjs",
    "login": "node src/login.js",
    "scrape": "node src/scrape.js",
    "scrape:recommend": "node src/scrape.js --tabs recommend",
    "scrape:following": "node src/scrape.js --tabs following"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=18"
  }
}

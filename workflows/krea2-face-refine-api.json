{
  "10": {
    "class_type": "UNETLoader",
    "_meta": {"title": "UNETLoader"},
    "inputs": {"unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default"}
  },
  "11": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "CLIPLoader"},
    "inputs": {"clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default"}
  },
  "12": {
    "class_type": "VAELoader",
    "_meta": {"title": "VAELoader"},
    "inputs": {"vae_name": "qwen_image_vae.safetensors"}
  },
  "40": {
    "class_type": "LoadImage",
    "_meta": {"title": "source image"},
    "inputs": {"image": "start.png"}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "positive"},
    "inputs": {"text": "a photorealistic portrait", "clip": ["11", 0]}
  },
  "13": {
    "class_type": "ConditioningZeroOut",
    "_meta": {"title": "negative (zeroed)"},
    "inputs": {"conditioning": ["6", 0]}
  },
  "30": {
    "class_type": "LoadMediaPipeFaceLandmarker",
    "_meta": {"title": "Load face detector"},
    "inputs": {"model_name": "mediapipe_face_fp32.safetensors"}
  },
  "31": {
    "class_type": "MediaPipeFaceLandmarker",
    "_meta": {"title": "Detect face"},
    "inputs": {
      "face_detection_model": ["30", 0],
      "image": ["40", 0],
      "detector_variant": "both",
      "num_faces": 0,
      "min_confidence": 0.4,
      "missing_frame_fallback": "empty"
    }
  },
  "32": {
    "class_type": "MediaPipeFaceMask",
    "_meta": {"title": "Face mask"},
    "inputs": {"face_landmarks": ["31", 0], "regions": "all"}
  },
  "33": {
    "class_type": "GrowMask",
    "_meta": {"title": "GrowMask"},
    "inputs": {"mask": ["32", 0], "expand": 64, "tapered_corners": true}
  },
  "34": {
    "class_type": "FeatherMask",
    "_meta": {"title": "FeatherMask"},
    "inputs": {"mask": ["33", 0], "left": 64, "top": 64, "right": 64, "bottom": 64}
  },
  "35": {
    "class_type": "VAEEncodeTiled",
    "_meta": {"title": "VAEEncodeTiled"},
    "inputs": {
      "pixels": ["40", 0],
      "vae": ["12", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "36": {
    "class_type": "SetLatentNoiseMask",
    "_meta": {"title": "SetLatentNoiseMask"},
    "inputs": {"samples": ["35", 0], "mask": ["34", 0]}
  },
  "37": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler face refine"},
    "inputs": {
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["13", 0],
      "latent_image": ["36", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.35
    }
  },
  "38": {
    "class_type": "VAEDecodeTiled",
    "_meta": {"title": "VAEDecodeTiled"},
    "inputs": {
      "samples": ["37", 0],
      "vae": ["12", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "39": {
    "class_type": "SaveImage",
    "_meta": {"title": "SaveImage"},
    "inputs": {"images": ["38", 0], "filename_prefix": "krea2_face"}
  }
}
